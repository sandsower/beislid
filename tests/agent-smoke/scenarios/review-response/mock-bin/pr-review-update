#!/usr/bin/env bash
set -euo pipefail
log=${PR_REVIEW_UPDATE_LOG:-}
out=${PR_REVIEW_UPDATE_PAYLOAD_COPY:-}
if [[ -z "$log" || -z "$out" ]]; then
  echo "PR_REVIEW_UPDATE_LOG and PR_REVIEW_UPDATE_PAYLOAD_COPY must be set" >&2
  exit 98
fi
mkdir -p "$(dirname "$log")" "$(dirname "$out")"
printf '%s\tcwd=%s\tpr-review-update' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$PWD" >> "$log"
for arg in "$@"; do printf ' %q' "$arg" >> "$log"; done
printf '\n' >> "$log"
if [[ $# -ne 2 || "${1:-}" != "reply" ]]; then
  echo "pr-review-update requires exactly: reply <json_file>" >&2
  exit 40
fi
json_file=$2
if [[ ! -f "$json_file" ]]; then
  echo "pr-review-update expected a real json_file path, got $json_file" >&2
  exit 42
fi
case "$json_file" in
  *$'\n'*)
    echo "pr-review-update got raw-looking JSON instead of path" >&2
    exit 43
    ;;
esac
cp "$json_file" "$out"
echo "ok: PR review reply posted"
