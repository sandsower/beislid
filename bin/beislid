#!/usr/bin/env bash
# Thin Beislið command dispatcher.

set -euo pipefail

_resolve_self() {
  local source="$1"
  while [[ -L "$source" ]]; do
    local dir target
    dir="$(cd -P "$(dirname "$source")" && pwd)"
    target="$(readlink "$source")"
    case "$target" in
      /*) source="$target" ;;
      *) source="$dir/$target" ;;
    esac
  done
  cd -P "$(dirname "$source")" && pwd
}

BEISLID_BIN_SELF_DIR="$(_resolve_self "${BASH_SOURCE[0]}")"
BEISLID_ROOT="$(cd "$BEISLID_BIN_SELF_DIR/.." && pwd)"
if [[ -n "${BEISLID_HOME:-}" ]] && \
   { [[ ! -f "$BEISLID_ROOT/scripts/install_lib.sh" ]] || \
     [[ ! -f "$BEISLID_ROOT/scripts/run_ledger.py" ]] || \
     [[ ! -f "$BEISLID_ROOT/scripts/action_policy.py" ]] || \
     [[ ! -f "$BEISLID_ROOT/scripts/validate_export.py" ]] || \
     [[ ! -f "$BEISLID_ROOT/scripts/visual_feedback.py" ]] || \
     [[ ! -f "$BEISLID_ROOT/scripts/workflow_normalizer.py" ]] || \
     [[ ! -d "$BEISLID_ROOT/skills" ]] || \
     [[ ! -f "$BEISLID_ROOT/install.sh" ]]; }; then
  if [[ -d "$BEISLID_HOME" ]]; then
    BEISLID_ROOT="$(cd "$BEISLID_HOME" && pwd)"
  else
    BEISLID_ROOT="$BEISLID_HOME"
  fi
fi

_validate_runtime_layout() {
  local root="$1"
  local missing=()
  [[ -f "$root/scripts/install_lib.sh" ]] || missing+=("scripts/install_lib.sh")
  [[ -d "$root/.beislid" ]] || missing+=(".beislid/")
  [[ -d "$root/skills" ]] || missing+=("skills/")
  [[ -f "$root/install.sh" ]] || missing+=("install.sh")
  [[ -f "$root/scripts/run_ledger.py" ]] || missing+=("scripts/run_ledger.py")
  [[ -f "$root/scripts/action_policy.py" ]] || missing+=("scripts/action_policy.py")
  [[ -f "$root/scripts/validate_export.py" ]] || missing+=("scripts/validate_export.py")
  [[ -f "$root/scripts/visual_feedback.py" ]] || missing+=("scripts/visual_feedback.py")
  [[ -f "$root/scripts/workflow_normalizer.py" ]] || missing+=("scripts/workflow_normalizer.py")

  if (( ${#missing[@]} > 0 )); then
    echo "error: Beislið runtime layout is incomplete at $root" >&2
    local item
    for item in "${missing[@]}"; do
      echo "       missing: $item" >&2
    done
    echo "       Set BEISLID_HOME to the Beislið runtime root if this is a packaged install." >&2
    exit 1
  fi
}

_validate_runtime_layout "$BEISLID_ROOT"
export BEISLID_HOME="$BEISLID_ROOT"

# shellcheck source=../scripts/install_lib.sh
source "$BEISLID_ROOT/scripts/install_lib.sh"

_usage() {
  cat <<'USAGE'
Beislið CLI

Usage:
  beislid install user [--with-security-hooks] [--force] [--strict]
  beislid install project [path] [--copy] [--write-gitignore] [--force] [--strict]
  beislid repair user [--force] [--strict]
  beislid repair project [path] [--force] [--strict]
  beislid status [project [path]]
  beislid plugin <enable|disable|status> lavish [--check]
  beislid workflow normalize --json
  beislid workflow-signal <emit|status> [...]
  beislid update [--force]
  beislid migrate v0.2 [--with-security-hooks] [--force]
  beislid run-ledger <init|event|workspace-receipt|workspace-event|checkpoint|gate|interrupt|finalize|resume|dashboard> [...]
  beislid action-policy <evaluate|validate> [...]
  beislid visual-feedback normalize [...]
  beislid export validate <bundle-dir>
  beislid help
USAGE
}

_legacy_guidance() {
  case "$1" in
    --status)
      echo "Use: beislid status" >&2
      ;;
    --update)
      echo "Use: beislid update" >&2
      ;;
    --project)
      echo "Use: beislid install project [path]" >&2
      ;;
    *)
      echo "Unknown flag: $1" >&2
      _usage >&2
      ;;
  esac
  exit 2
}

_parse_user_install_flags() {
  while (($#)); do
    case "$1" in
      --with-security-hooks) WITH_SECURITY_HOOKS=1 ;;
      --force|--repoint) FORCE=1 ;;
      --strict) STRICT=1 ;;
      -h|--help)
        _usage
        exit 0
        ;;
      --project|--status|--update)
        _legacy_guidance "$1"
        ;;
      *)
        echo "Unknown install user flag: $1" >&2
        _usage >&2
        exit 2
        ;;
    esac
    shift
  done
}

_parse_project_install_flags() {
  PROJECT_PATH=""
  while (($#)); do
    case "$1" in
      --force|--repoint) FORCE=1 ;;
      --strict) STRICT=1 ;;
      --copy) PROJECT_MODE="copy" ;;
      --write-gitignore) PROJECT_WRITE_GITIGNORE=1 ;;
      -h|--help)
        _usage
        exit 0
        ;;
      --*)
        echo "Unknown install project flag: $1" >&2
        _usage >&2
        exit 2
        ;;
      *)
        if [[ -n "$PROJECT_PATH" ]]; then
          echo "install project accepts at most one path" >&2
          _usage >&2
          exit 2
        fi
        PROJECT_PATH="$1"
        ;;
    esac
    shift
  done
}

_parse_update_flags() {
  while (($#)); do
    case "$1" in
      --force|--repoint) FORCE=1 ;;
      -h|--help)
        _usage
        exit 0
        ;;
      *)
        echo "Unknown update flag: $1" >&2
        _usage >&2
        exit 2
        ;;
    esac
    shift
  done
}

_parse_repair_user_flags() {
  while (($#)); do
    case "$1" in
      --force|--repoint) FORCE=1 ;;
      --strict) STRICT=1 ;;
      -h|--help)
        _usage
        exit 0
        ;;
      *)
        echo "Unknown repair user flag: $1" >&2
        _usage >&2
        exit 2
        ;;
    esac
    shift
  done
}

_parse_repair_project_flags() {
  REPAIR_PROJECT_PATH=""
  while (($#)); do
    case "$1" in
      --force|--repoint) FORCE=1 ;;
      --strict) STRICT=1 ;;
      -h|--help)
        _usage
        exit 0
        ;;
      --*)
        echo "Unknown repair project flag: $1" >&2
        _usage >&2
        exit 2
        ;;
      *)
        if [[ -n "$REPAIR_PROJECT_PATH" ]]; then
          echo "repair project accepts at most one path" >&2
          _usage >&2
          exit 2
        fi
        REPAIR_PROJECT_PATH="$1"
        ;;
    esac
    shift
  done
}

_parse_migrate_flags() {
  while (($#)); do
    case "$1" in
      --with-security-hooks) WITH_SECURITY_HOOKS=1 ;;
      --force|--repoint) FORCE=1 ;;
      -h|--help)
        _usage
        exit 0
        ;;
      *)
        echo "Unknown migrate flag: $1" >&2
        _usage >&2
        exit 2
        ;;
    esac
    shift
  done
}

cmd="${1:-help}"
case "$cmd" in
  help|-h|--help)
    _usage
    ;;
  --status|--update|--project)
    _legacy_guidance "$cmd"
    ;;
  status)
    shift
    if (($# == 0)); then
      beislid_status
    elif [[ "${1:-}" == "project" ]]; then
      shift
      if (($# > 1)); then
        echo "beislid status project accepts at most one path" >&2
        _usage >&2
        exit 2
      fi
      beislid_status_project "${1:-}"
    else
      echo "Unknown status target: $1" >&2
      _usage >&2
      exit 2
    fi
    ;;
  update)
    shift
    _parse_update_flags "$@"
    beislid_update_repo
    ;;
  migrate)
    shift
    target="${1:-}"
    case "$target" in
      v0.2|v0.2.0|0.2|0.2.0)
        shift
        _parse_migrate_flags "$@"
        beislid_migrate_v0_2
        ;;
      ""|-h|--help)
        _usage
        ;;
      *)
        echo "Unknown migration target: $target" >&2
        _usage >&2
        exit 2
        ;;
    esac
    ;;
  run-ledger)
    shift
    if ! command -v python3 >/dev/null 2>&1; then
      echo "error: beislid run-ledger requires python3" >&2
      exit 1
    fi
    python3 "$BEISLID_ROOT/scripts/run_ledger.py" "$@"
    ;;
  action-policy)
    shift
    if ! command -v python3 >/dev/null 2>&1; then
      echo "error: beislid action-policy requires python3" >&2
      exit 1
    fi
    python3 "$BEISLID_ROOT/scripts/action_policy.py" "$@"
    ;;
  visual-feedback)
    shift
    subcmd="${1:-}"
    case "$subcmd" in
      normalize)
        shift
        if ! command -v python3 >/dev/null 2>&1; then
          echo "error: beislid visual-feedback requires python3" >&2
          exit 1
        fi
        python3 "$BEISLID_ROOT/scripts/visual_feedback.py" "$@"
        ;;
      "")
        echo "Missing visual-feedback subcommand." >&2
        _usage >&2
        exit 2
        ;;
      *)
        echo "Unknown visual-feedback subcommand: $subcmd" >&2
        _usage >&2
        exit 2
        ;;
    esac
    ;;
  workflow)
    shift
    subcmd="${1:-}"
    case "$subcmd" in
      normalize)
        shift
        if [[ "${1:-}" != "--json" ]] || (( $# != 1 )); then
          echo "Usage: beislid workflow normalize --json" >&2
          exit 2
        fi
        if ! command -v python3 >/dev/null 2>&1; then
          echo "error: beislid workflow normalize requires python3" >&2
          exit 1
        fi
        python3 "$BEISLID_ROOT/scripts/workflow_normalizer.py" --json
        ;;
      "")
        echo "Missing workflow subcommand." >&2
        _usage >&2
        exit 2
        ;;
      *)
        echo "Unknown workflow subcommand: $subcmd" >&2
        _usage >&2
        exit 2
        ;;
    esac
    ;;
  export)
    shift
    subcmd="${1:-}"
    case "$subcmd" in
      validate)
        shift
        if ! command -v python3 >/dev/null 2>&1; then
          echo "error: beislid export requires python3" >&2
          exit 1
        fi
        python3 "$BEISLID_ROOT/scripts/validate_export.py" "$@"
        ;;
      "")
        echo "Missing export subcommand." >&2
        _usage >&2
        exit 2
        ;;
      *)
        echo "Unknown export subcommand: $subcmd" >&2
        _usage >&2
        exit 2
        ;;
    esac
    ;;
  workflow-signal)
    shift
    beislid_workflow_signal "$@"
    ;;
  plugin)
    shift
    subcmd="${1:-}"
    case "$subcmd" in
      enable)
        shift
        plugin="${1:-}"
        if [[ "$plugin" != "lavish" ]]; then
          echo "Unknown plugin: ${plugin:-}" >&2
          _usage >&2
          exit 2
        fi
        shift
        beislid_plugin_lavish_enable "$@"
        ;;
      disable)
        shift
        plugin="${1:-}"
        if [[ "$plugin" != "lavish" ]]; then
          echo "Unknown plugin: ${plugin:-}" >&2
          _usage >&2
          exit 2
        fi
        shift
        beislid_plugin_lavish_disable "$@"
        ;;
      status)
        shift
        plugin="${1:-}"
        if [[ "$plugin" != "lavish" ]]; then
          echo "Unknown plugin: ${plugin:-}" >&2
          _usage >&2
          exit 2
        fi
        shift
        beislid_plugin_lavish_status "$@"
        ;;
      "")
        echo "Missing plugin subcommand." >&2
        _usage >&2
        exit 2
        ;;
      *)
        echo "Unknown plugin subcommand: $subcmd" >&2
        _usage >&2
        exit 2
        ;;
    esac
    ;;
  install)
    shift
    subcmd="${1:-}"
    case "$subcmd" in
      user)
        shift
        _parse_user_install_flags "$@"
        beislid_install_user
        ;;
      project)
        shift
        _parse_project_install_flags "$@"
        beislid_install_project "$PROJECT_PATH"
        ;;
      "")
        echo "Missing install target." >&2
        _usage >&2
        exit 2
        ;;
      *)
        echo "Unknown install target: $subcmd" >&2
        _usage >&2
        exit 2
        ;;
    esac
    ;;
  repair)
    shift
    subcmd="${1:-}"
    case "$subcmd" in
      user)
        shift
        _parse_repair_user_flags "$@"
        beislid_repair_user
        ;;
      project)
        shift
        _parse_repair_project_flags "$@"
        beislid_repair_project "$REPAIR_PROJECT_PATH"
        ;;
      "")
        echo "Missing repair target." >&2
        _usage >&2
        exit 2
        ;;
      *)
        echo "Unknown repair target: $subcmd" >&2
        _usage >&2
        exit 2
        ;;
    esac
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    _usage >&2
    exit 2
    ;;
esac
