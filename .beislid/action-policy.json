{
  "modes": {
    "supervised-auto": {
      "rules": { "dependency-install": "allow", "git-remote": "allow" },
      "actions": {
        "dependency.install": "allow",
        "ticket.fetch": "allow",
        "ticket.comment": "allow",
        "ticket.update": "allow",
        "tracker.issue.transition": "allow",
        "workspace.lifecycle.create": "allow",
        "workspace.lifecycle.remove": "allow",
        "workspace.lifecycle.remove_stale_path": "allow",
        "workspace.cleanup.tmp": "allow",
        "workspace.hook.after_create": "allow",
        "workspace.hook.before_run": "allow",
        "workspace.hook.after_run": "allow",
        "workspace.hook.before_remove": "allow",
        "pr.review.reply": "allow",
        "git.push": "allow",
        "gh.pr.create": "allow",
        "gh.pr.merge": "allow",
        "pr.merge": "allow",
        "memento.capture": "allow",
        "retro.run": "allow",
        "retro.apply": "allow",
        "git.remote.branch.delete": "allow"
      }
    },
    "unattended-auto": {
      "rules": { "dependency-install": "allow", "git-remote": "allow" },
      "sandbox": { "minimum": "non-default-branch", "on_uncommitted_changes": "allow" },
      "actions": {
        "dependency.install": "allow",
        "ticket.fetch": "allow",
        "ticket.comment": "allow",
        "ticket.update": "allow",
        "tracker.issue.transition": "allow",
        "workspace.lifecycle.create": "allow",
        "workspace.lifecycle.remove": "allow",
        "workspace.lifecycle.remove_stale_path": "allow",
        "workspace.cleanup.tmp": "allow",
        "workspace.hook.after_create": "allow",
        "workspace.hook.before_run": "allow",
        "workspace.hook.after_run": "allow",
        "workspace.hook.before_remove": "allow",
        "pr.review.reply": "allow",
        "git.push": "allow",
        "gh.pr.create": "allow"
      }
    }
  }
}
